{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resguardo",
  "version": "0.6.8",
  "identifier": "io.github.resguardo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Resguardo",
        "width": 1100,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "license": "AGPL-3.0-or-later",
    "publisher": "Resguardo",
    "copyright": "© 2026 Ever Caro y colaboradores · AGPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "Interfaz gráfica para restic",
    "externalBin": [
      "binaries/restic",
      "binaries/rest-server"
    ],
    "resources": {
      "licenses/restic-LICENSE.txt": "licenses/restic-LICENSE.txt",
      "licenses/rest-server-LICENSE.txt": "licenses/rest-server-LICENSE.txt",
      "../LICENSE": "licenses/Resguardo-LICENSE.txt",
      "../NOTICE": "licenses/NOTICE.txt",
      "resources/agente/*": "agente/"
    },
    "longDescription": "Resguardo administra y vigila copias de seguridad hechas con restic: copias con progreso, copias automáticas, explorar y restaurar snapshots, retención y estado de todos los repositorios.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
