{
  "name": "resguardo",
  "version": "0.6.8",
  "description": "Interfaz gráfica sencilla y segura para restic",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "build:servidor": "node scripts/build-servidor.mjs",
    "build:agente": "node scripts/build-agente.mjs",
    "build:plataforma": "node scripts/build-agente.mjs && node scripts/build-servidor.mjs",
    "build:todo": "node scripts/build-agente.mjs --tauri",
    "arte:instaladores": "node scripts/arte-instaladores.mjs",
    "test:sin-referencias": "node scripts/sin-referencias.mjs"
  },
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.48.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.6.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
