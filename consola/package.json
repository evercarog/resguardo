{
  "name": "resguardo-consola",
  "version": "0.1.0",
  "private": true,
  "description": "Consola web de Resguardo Server (SPA que el servidor lleva dentro)",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite dev",
    "dev:mock": "vite dev --mode mock",
    "build": "vite build && node scripts/arranque-externo.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:vectores": "tsx scripts/vectores.ts && tsx scripts/vectores-detalle.ts && tsx scripts/vectores-panel.ts && tsx scripts/vectores-notas.ts && tsx scripts/vectores-historial.ts && tsx scripts/vectores-buscar.ts && tsx scripts/vectores-donde.ts && tsx scripts/vectores-emparejar.ts && tsx scripts/vectores-retencion.ts && tsx scripts/vectores-consolas.ts",
    "e2e": "tsx scripts/e2e/escenario.ts",
    "build:ventana": "vite build --config vite.ventana.config.ts",
    "dev:ventana": "vite --config vite.ventana.config.ts",
    "check:ventana": "cd ventana && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.48.0",
    "@noble/ciphers": "^2.0.0",
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "hash-wasm": "^4.12.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^26.6.4",
    "libsodium-wrappers": "^0.8.4",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
